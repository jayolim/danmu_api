{
  "version": 2,
  "routes": [
    {
      "src": "/",
      "dest": "/danmu_api/worker.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/danmu_api/worker.js"
    },
    {
      "src": "/([^/]+)/api/(.*)",
      "dest": "/danmu_api/worker.js"
    },
    {
      "src": "/(.*)",
      "dest": "/danmu_api/worker.js"
    }
  ]
}
