{
  "version": 2,
  "functions": {
    "danmu_api/worker.js": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/danmu_api/worker.js" },
    { "source": "/api/(.*)", "destination": "/danmu_api/worker.js" },
    { "source": "/([^/]+)/api/(.*)", "destination": "/danmu_api/worker.js" },
    { "source": "/(.*)", "destination": "/danmu_api/worker.js" }
  ]
}
